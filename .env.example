# Campus Auction Platform Environment Configuration Template

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/"your db name"
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD="your postgres password"

# Server Port (default 8085 to avoid conflicts with other local services)
PORT=8085

# Security / JWT Secret (at least 256-bit / 32 characters)
JWT_SECRET=campus_auction_secret_key_minimum_32_characters_long_for_hmac256_security_production_token
JWT_EXPIRATION_MS=86400000

# Campus Verification Settings
# Approved college domains (comma-separated). Set to * to allow all domains or specific domains like @campus.edu,@college.ac.in
CAMPUS_APPROVED_EMAIL_DOMAINS=@campus.edu,@university.ac.in,@college.edu

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173,http://localhost:3000

# Uploads Configuration
UPLOAD_DIR=./uploads

# Cloudinary (Optional, fallback to local uploads if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq AI Assistant Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
